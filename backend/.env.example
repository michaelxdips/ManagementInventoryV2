PORT=3000
NODE_ENV=development
JWT_SECRET=your-strong-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory
DB_CONNECTION_LIMIT=10

# Production with managed MySQL should usually enable SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Aiven (or any provider) CA certificate for secure DB connections.
# Option A: Path to the CA cert file downloaded from Aiven console.
# DB_SSL_CA_PATH=/path/to/ca.pem
# Option B: Inline PEM content (replace newlines with \n).
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# Production: daftar origin frontend (pisahkan koma). Kosongkan = izinkan semua (dev).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Rate limit global (default 500 req / 15 menit)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500

# Login rate limit (default 10 attempts / 15 menit)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# Email: isi SMTP_* untuk produksi. Tanpa SMTP_HOST = mode Ethereal (dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Inventory ATK" <noreply@example.com>
# MAIL_TO_ADMIN=admin@example.com,ops@example.com
