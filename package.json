{
    "name": "inventory-management-system",
    "version": "1.0.0",
    "description": "Web Inventory Management System PKL",
    "scripts": {
        "dev": "run-p dev:*",
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "start": "npm run dev",
        "check": "run-s check:frontend check:backend",
        "check:frontend": "cd frontend && npm run build && npx tsc --noEmit && npm test && npm run lint",
        "check:backend": "cd backend && node --check src/index.js && npm run lint"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5"
    },
    "keywords": [
        "inventory",
        "atk",
        "pkl"
    ],
    "author": "",
    "license": "ISC"
}
